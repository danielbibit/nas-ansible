// Managed by Ansible

// === Metrics ===
// Scrape the local node_exporter and push to the NAS Prometheus
prometheus.scrape "node" {
  targets = [
    {
      __address__ = "{{ alloy_node_exporter_target }}",
      instance    = "{{ alloy_instance }}",
    },
  ]
  job_name        = "{{ alloy_instance }}_exporter"
  scrape_interval = "{{ alloy_scrape_interval }}"
  forward_to      = [prometheus.remote_write.nas.receiver]
}

prometheus.remote_write "nas" {
  endpoint {
    url = "{{ alloy_prometheus_url }}"
  }

  // Lets alerts tell pushed hosts apart from scraped ones
  external_labels = {
    collector = "alloy",
  }
}
{% if alloy_logs_enabled %}

// === Logs ===
// Same labels as the promtail config, so existing Loki queries keep working
local.file_match "varlogs" {
  path_targets = [
    {
      __path__ = "{{ alloy_log_paths }}",
      job      = "varlogs",
      host     = "{{ alloy_instance }}",
    },
  ]
}

loki.source.file "varlogs" {
  targets    = local.file_match.varlogs.targets
  forward_to = [loki.process.varlogs.receiver]
}

// Keep only the file name without extension, like promtail did
loki.process "varlogs" {
  stage.regex {
    expression = ".*/(?P<name>[^/]+)\\.log$"
    source     = "filename"
  }

  stage.labels {
    values = {
      filename = "name",
    }
  }

  forward_to = [loki.write.nas.receiver]
}

loki.relabel "journal" {
  forward_to = []

  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }
}

loki.source.journal "journal" {
  max_age       = "{{ alloy_journal_max_age }}"
  relabel_rules = loki.relabel.journal.rules
  labels        = {
    job  = "systemd-journal",
    host = "{{ alloy_instance }}",
  }
  forward_to    = [loki.write.nas.receiver]
}

loki.write "nas" {
  endpoint {
    url = "{{ alloy_loki_url }}"
  }
}
{% endif %}
