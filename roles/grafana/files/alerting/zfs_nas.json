{
  "apiVersion": 1,
  "groups": [
    {
      "folder": "NAS",
      "interval": "1m",
      "name": "ZFS",
      "orgId": 1,
      "rules": [
        {
          "annotations": {
            "description": "Pool is {{ printf \"%.1f\" $values.A.Value }}% full, ZFS gets slower and fragments faster as it fills.",
            "summary": "Pool {{ $labels.zpool }} on {{ $labels.instance }} is above 90% full"
          },
          "condition": "B",
          "data": [
            {
              "datasourceUid": "Ao-uhfy7k",
              "model": {
                "expr": "100 * zfs_zpool_allocated_bytes / zfs_zpool_size_bytes",
                "instant": true,
                "range": false,
                "refId": "A"
              },
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              }
            },
            {
              "datasourceUid": "__expr__",
              "model": {
                "conditions": [
                  {
                    "evaluator": {
                      "params": [
                        90
                      ],
                      "type": "gt"
                    }
                  }
                ],
                "expression": "A",
                "refId": "B",
                "type": "threshold"
              },
              "refId": "B"
            }
          ],
          "execErrState": "Error",
          "for": "10m",
          "labels": {
            "severity": "warning"
          },
          "noDataState": "OK",
          "title": "ZFS pool filling up",
          "uid": "zfs_pool_capacity_high"
        },
        {
          "annotations": {
            "description": "Pool is {{ printf \"%.1f\" $values.A.Value }}% full, free up space before writes start failing.",
            "summary": "Pool {{ $labels.zpool }} on {{ $labels.instance }} is above 95% full"
          },
          "condition": "B",
          "data": [
            {
              "datasourceUid": "Ao-uhfy7k",
              "model": {
                "expr": "100 * zfs_zpool_allocated_bytes / zfs_zpool_size_bytes",
                "instant": true,
                "range": false,
                "refId": "A"
              },
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              }
            },
            {
              "datasourceUid": "__expr__",
              "model": {
                "conditions": [
                  {
                    "evaluator": {
                      "params": [
                        95
                      ],
                      "type": "gt"
                    }
                  }
                ],
                "expression": "A",
                "refId": "B",
                "type": "threshold"
              },
              "refId": "B"
            }
          ],
          "execErrState": "Error",
          "for": "5m",
          "labels": {
            "severity": "critical"
          },
          "noDataState": "OK",
          "title": "ZFS pool almost full",
          "uid": "zfs_pool_capacity_critical"
        },
        {
          "annotations": {
            "description": "Only {{ printf \"%.1f\" $values.A.Value }}% of the quota of {{ $labels.dataset }} is free.",
            "summary": "{{ $labels.dataset }} on {{ $labels.instance }} has less than 10% of its quota free"
          },
          "condition": "B",
          "data": [
            {
              "datasourceUid": "Ao-uhfy7k",
              "model": {
                "expr": "100 * zfs_dataset_available_bytes / (zfs_dataset_used_bytes + zfs_dataset_available_bytes) and (zfs_dataset_available_bytes < on(instance, zpool) group_left() max by (instance, zpool) (zfs_dataset_available_bytes and on(instance, dataset) label_replace(zfs_zpool_size_bytes, \"dataset\", \"$1\", \"zpool\", \"(.*)\")))",
                "instant": true,
                "range": false,
                "refId": "A"
              },
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              }
            },
            {
              "datasourceUid": "__expr__",
              "model": {
                "conditions": [
                  {
                    "evaluator": {
                      "params": [
                        10
                      ],
                      "type": "lt"
                    }
                  }
                ],
                "expression": "A",
                "refId": "B",
                "type": "threshold"
              },
              "refId": "B"
            }
          ],
          "execErrState": "Error",
          "for": "10m",
          "labels": {
            "severity": "warning"
          },
          "noDataState": "OK",
          "title": "ZFS dataset quota filling up",
          "uid": "zfs_quota_low"
        },
        {
          "annotations": {
            "description": "Only {{ printf \"%.1f\" $values.A.Value }}% of the quota of {{ $labels.dataset }} is free.",
            "summary": "{{ $labels.dataset }} on {{ $labels.instance }} has less than 5% of its quota free"
          },
          "condition": "B",
          "data": [
            {
              "datasourceUid": "Ao-uhfy7k",
              "model": {
                "expr": "100 * zfs_dataset_available_bytes / (zfs_dataset_used_bytes + zfs_dataset_available_bytes) and (zfs_dataset_available_bytes < on(instance, zpool) group_left() max by (instance, zpool) (zfs_dataset_available_bytes and on(instance, dataset) label_replace(zfs_zpool_size_bytes, \"dataset\", \"$1\", \"zpool\", \"(.*)\")))",
                "instant": true,
                "range": false,
                "refId": "A"
              },
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              }
            },
            {
              "datasourceUid": "__expr__",
              "model": {
                "conditions": [
                  {
                    "evaluator": {
                      "params": [
                        5
                      ],
                      "type": "lt"
                    }
                  }
                ],
                "expression": "A",
                "refId": "B",
                "type": "threshold"
              },
              "refId": "B"
            }
          ],
          "execErrState": "Error",
          "for": "5m",
          "labels": {
            "severity": "critical"
          },
          "noDataState": "OK",
          "title": "ZFS dataset quota almost full",
          "uid": "zfs_quota_critical"
        },
        {
          "annotations": {
            "description": "Last scrub finished {{ printf \"%.0f\" $values.A.Value }} days ago. The monthly scrub skips degraded pools, run zpool scrub {{ $labels.zpool }} by hand.",
            "summary": "Pool {{ $labels.zpool }} on {{ $labels.instance }} was not scrubbed in over 40 days"
          },
          "condition": "B",
          "data": [
            {
              "datasourceUid": "Ao-uhfy7k",
              "model": {
                "expr": "(time() - zfs_zpool_scan_last_end_timestamp_seconds{function=\"scrub\"}) / 86400",
                "instant": true,
                "range": false,
                "refId": "A"
              },
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              }
            },
            {
              "datasourceUid": "__expr__",
              "model": {
                "conditions": [
                  {
                    "evaluator": {
                      "params": [
                        40
                      ],
                      "type": "gt"
                    }
                  }
                ],
                "expression": "A",
                "refId": "B",
                "type": "threshold"
              },
              "refId": "B"
            }
          ],
          "execErrState": "Error",
          "for": "1h",
          "labels": {
            "severity": "warning"
          },
          "noDataState": "OK",
          "title": "ZFS scrub overdue",
          "uid": "zfs_scrub_overdue"
        }
      ]
    }
  ]
}
