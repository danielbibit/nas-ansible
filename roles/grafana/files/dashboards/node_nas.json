{
  "annotations": {},
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": "single",
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 0,
      "panels": [],
      "title": "Overview",
      "type": "row"
    },
    {
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "green",
                  "index": 0,
                  "text": "Physical"
                },
                "1": {
                  "color": "blue",
                  "index": 1,
                  "text": "Virtual machine"
                }
              },
              "type": "value"
            }
          ]
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 0,
        "y": 1
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": []
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "count(node_dmi_info{instance=~\"$host\", system_vendor=~\"QEMU|VMware.*|innotek GmbH|Xen|Amazon EC2|Parallels.*\"} or node_dmi_info{instance=~\"$host\", product_name=\"Virtual Machine\"}) or count(node_dmi_info{instance=~\"$host\"}) * 0",
          "instant": true,
          "range": false,
          "refId": ""
        }
      ],
      "title": "Platform",
      "transparent": false,
      "type": "stat"
    },
    {
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "green",
            "mode": "fixed"
          },
          "unit": "dtdhms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 3,
        "y": 1
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": []
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "time() - node_boot_time_seconds{instance=~\"$host\"}",
          "instant": true,
          "range": false,
          "refId": ""
        }
      ],
      "title": "Uptime",
      "transparent": false,
      "type": "stat"
    },
    {
      "fieldConfig": {
        "defaults": {
          "max": 100.0,
          "min": 0.0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 6,
        "y": 1
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\", instance=~\"$host\"}[5m])))",
          "instant": true,
          "range": false,
          "refId": ""
        }
      ],
      "title": "CPU Usage",
      "transparent": false,
      "type": "gauge"
    },
    {
      "description": "Memory used by applications, the ZFS ARC is excluded because it is released under pressure",
      "fieldConfig": {
        "defaults": {
          "max": 100.0,
          "min": 0.0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 10,
        "y": 1
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "100 * (node_memory_MemTotal_bytes{instance=~\"$host\"} - node_memory_MemAvailable_bytes{instance=~\"$host\"} - (node_zfs_arc_size{instance=~\"$host\"} or node_memory_MemTotal_bytes{instance=~\"$host\"} * 0)) / node_memory_MemTotal_bytes{instance=~\"$host\"}",
          "instant": true,
          "range": false,
          "refId": ""
        }
      ],
      "title": "Memory Usage",
      "transparent": false,
      "type": "gauge"
    },
    {
      "description": "Load average divided by the number of CPUs, above 1 means tasks are waiting",
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 0.7
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 14,
        "y": 1
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": []
        },
        "showPercentChange": false,
        "textMode": "value_and_name",
        "wideLayout": true
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "node_load1{instance=~\"$host\"} / scalar(count(node_cpu_seconds_total{mode=\"idle\", instance=~\"$host\"}))",
          "instant": true,
          "legendFormat": "1m",
          "range": false,
          "refId": ""
        },
        {
          "expr": "node_load5{instance=~\"$host\"} / scalar(count(node_cpu_seconds_total{mode=\"idle\", instance=~\"$host\"}))",
          "instant": true,
          "legendFormat": "5m",
          "range": false,
          "refId": ""
        },
        {
          "expr": "node_load15{instance=~\"$host\"} / scalar(count(node_cpu_seconds_total{mode=\"idle\", instance=~\"$host\"}))",
          "instant": true,
          "legendFormat": "15m",
          "range": false,
          "refId": ""
        }
      ],
      "title": "Load per CPU",
      "transparent": false,
      "type": "stat"
    },
    {
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 5368709120
              },
              {
                "color": "green",
                "value": 10737418240
              }
            ]
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 17,
        "y": 1
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": []
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "node_filesystem_avail_bytes{mountpoint=\"/\", instance=~\"$host\"}",
          "instant": true,
          "range": false,
          "refId": ""
        }
      ],
      "title": "Root Free",
      "transparent": false,
      "type": "stat"
    },
    {
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          },
          "unit": "celsius"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 2,
        "x": 20,
        "y": 1
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": []
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "max(node_hwmon_temp_celsius{instance=~\"$host\"})",
          "instant": true,
          "range": false,
          "refId": ""
        }
      ],
      "title": "Max Temp",
      "transparent": false,
      "type": "stat"
    },
    {
      "description": "systemd units in failed state, listed in the System row",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 2,
        "x": 22,
        "y": 1
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": []
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "count(node_systemd_unit_state{state=\"failed\", instance=~\"$host\"} == 1) or vector(0)",
          "instant": true,
          "range": false,
          "refId": ""
        }
      ],
      "title": "Failed Units",
      "transparent": false,
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "id": 0,
      "panels": [],
      "title": "CPU",
      "type": "row"
    },
    {
      "description": "iowait is time spent waiting on disks",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 30,
            "stacking": {
              "mode": "normal"
            }
          },
          "max": 100.0,
          "min": 0.0,
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 6
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "sum by (mode) (rate(node_cpu_seconds_total{mode!=\"idle\", instance=~\"$host\"}[$__rate_interval])) * 100 / scalar(count(node_cpu_seconds_total{mode=\"idle\", instance=~\"$host\"}))",
          "interval": "1m",
          "legendFormat": "{{mode}}",
          "refId": ""
        }
      ],
      "title": "CPU Usage by Mode",
      "transparent": false,
      "type": "timeseries"
    },
    {
      "description": "Share of time at least one task was waiting for a CPU",
      "fieldConfig": {
        "defaults": {
          "min": 0.0,
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 6
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "rate(node_pressure_cpu_waiting_seconds_total{instance=~\"$host\"}[$__rate_interval]) * 100",
          "interval": "1m",
          "legendFormat": "waiting",
          "refId": ""
        }
      ],
      "title": "CPU Pressure",
      "transparent": false,
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "id": 0,
      "panels": [],
      "title": "Memory",
      "type": "row"
    },
    {
      "description": "Available includes page cache that can be reclaimed",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 30,
            "stacking": {
              "mode": "normal"
            }
          },
          "min": 0.0,
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "(node_memory_MemTotal_bytes{instance=~\"$host\"} - node_memory_MemAvailable_bytes{instance=~\"$host\"} - (node_zfs_arc_size{instance=~\"$host\"} or node_memory_MemTotal_bytes{instance=~\"$host\"} * 0))",
          "interval": "1m",
          "legendFormat": "applications",
          "refId": ""
        },
        {
          "expr": "(node_zfs_arc_size{instance=~\"$host\"} or node_memory_MemTotal_bytes{instance=~\"$host\"} * 0)",
          "interval": "1m",
          "legendFormat": "ZFS ARC",
          "refId": ""
        },
        {
          "expr": "node_memory_MemAvailable_bytes{instance=~\"$host\"}",
          "interval": "1m",
          "legendFormat": "available",
          "refId": ""
        }
      ],
      "title": "Memory",
      "transparent": false,
      "type": "timeseries"
    },
    {
      "description": "Waiting: some tasks stalled on memory, stalled: all tasks stalled on memory",
      "fieldConfig": {
        "defaults": {
          "min": 0.0,
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 12,
        "y": 16
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "rate(node_pressure_memory_waiting_seconds_total{instance=~\"$host\"}[$__rate_interval]) * 100",
          "interval": "1m",
          "legendFormat": "waiting",
          "refId": ""
        },
        {
          "expr": "rate(node_pressure_memory_stalled_seconds_total{instance=~\"$host\"}[$__rate_interval]) * 100",
          "interval": "1m",
          "legendFormat": "stalled",
          "refId": ""
        }
      ],
      "title": "Memory Pressure",
      "transparent": false,
      "type": "timeseries"
    },
    {
      "description": "Processes killed by the kernel for lack of memory in the selected time range",
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 4,
        "x": 20,
        "y": 16
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": []
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "increase(node_vmstat_oom_kill{instance=~\"$host\"}[$__range])",
          "instant": true,
          "range": false,
          "refId": ""
        }
      ],
      "title": "OOM Kills",
      "transparent": false,
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 25
      },
      "id": 0,
      "panels": [],
      "title": "Disks",
      "type": "row"
    },
    {
      "description": "Share of time the disk was busy, a single disk stuck near 100% is a sign of trouble",
      "fieldConfig": {
        "defaults": {
          "max": 100.0,
          "min": 0.0,
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 26
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "rate(node_disk_io_time_seconds_total{instance=~\"$host\", device=~\"sd.*|nvme.*|vd.*|hd.*\"}[$__rate_interval]) * 100 * on(instance, device) group_left(serial) node_disk_info{instance=~\"$host\"}",
          "interval": "1m",
          "legendFormat": "{{device}} {{serial}}",
          "refId": ""
        }
      ],
      "title": "Disk Utilisation",
      "transparent": false,
      "type": "timeseries"
    },
    {
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 26
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "rate(node_disk_read_bytes_total{instance=~\"$host\", device=~\"sd.*|nvme.*|vd.*|hd.*\"}[$__rate_interval]) * on(instance, device) group_left(serial) node_disk_info{instance=~\"$host\"}",
          "interval": "1m",
          "legendFormat": "{{device}} {{serial}} read",
          "refId": ""
        },
        {
          "expr": "-rate(node_disk_written_bytes_total{instance=~\"$host\", device=~\"sd.*|nvme.*|vd.*|hd.*\"}[$__rate_interval]) * on(instance, device) group_left(serial) node_disk_info{instance=~\"$host\"}",
          "interval": "1m",
          "legendFormat": "{{device}} {{serial}} write",
          "refId": ""
        }
      ],
      "title": "Disk Throughput (read + / write -)",
      "transparent": false,
      "type": "timeseries"
    },
    {
      "fieldConfig": {
        "defaults": {
          "min": 0.0,
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 35
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "(rate(node_disk_read_time_seconds_total{instance=~\"$host\", device=~\"sd.*|nvme.*|vd.*|hd.*\"}[$__rate_interval]) / rate(node_disk_reads_completed_total{instance=~\"$host\", device=~\"sd.*|nvme.*|vd.*|hd.*\"}[$__rate_interval])) * on(instance, device) group_left(serial) node_disk_info{instance=~\"$host\"}",
          "interval": "1m",
          "legendFormat": "{{device}} {{serial}}",
          "refId": ""
        }
      ],
      "title": "Disk Read Latency",
      "transparent": false,
      "type": "timeseries"
    },
    {
      "fieldConfig": {
        "defaults": {
          "min": 0.0,
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 35
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "(rate(node_disk_write_time_seconds_total{instance=~\"$host\", device=~\"sd.*|nvme.*|vd.*|hd.*\"}[$__rate_interval]) / rate(node_disk_writes_completed_total{instance=~\"$host\", device=~\"sd.*|nvme.*|vd.*|hd.*\"}[$__rate_interval])) * on(instance, device) group_left(serial) node_disk_info{instance=~\"$host\"}",
          "interval": "1m",
          "legendFormat": "{{device}} {{serial}}",
          "refId": ""
        }
      ],
      "title": "Disk Write Latency",
      "transparent": false,
      "type": "timeseries"
    },
    {
      "description": "Waiting: some tasks stalled on I/O, stalled: all tasks stalled on I/O",
      "fieldConfig": {
        "defaults": {
          "min": 0.0,
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 44
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "rate(node_pressure_io_waiting_seconds_total{instance=~\"$host\"}[$__rate_interval]) * 100",
          "interval": "1m",
          "legendFormat": "waiting",
          "refId": ""
        },
        {
          "expr": "rate(node_pressure_io_stalled_seconds_total{instance=~\"$host\"}[$__rate_interval]) * 100",
          "interval": "1m",
          "legendFormat": "stalled",
          "refId": ""
        }
      ],
      "title": "I/O Pressure",
      "transparent": false,
      "type": "timeseries"
    },
    {
      "description": "ZFS datasets are on the ZFS dashboard",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Used"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 80
                    },
                    {
                      "color": "red",
                      "value": 90
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "mode": "basic",
                  "type": "color-background"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 8,
        "y": 44
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "node_filesystem_size_bytes{instance=~\"$host\", fstype!~\"tmpfs|ramfs|overlay|squashfs|nsfs|zfs|fuse.*\", device!=\"tmpfs\"}",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": ""
        },
        {
          "expr": "node_filesystem_avail_bytes{instance=~\"$host\", fstype!~\"tmpfs|ramfs|overlay|squashfs|nsfs|zfs|fuse.*\", device!=\"tmpfs\"}",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": ""
        },
        {
          "expr": "100 * (1 - node_filesystem_avail_bytes{instance=~\"$host\", fstype!~\"tmpfs|ramfs|overlay|squashfs|nsfs|zfs|fuse.*\", device!=\"tmpfs\"} / node_filesystem_size_bytes{instance=~\"$host\", fstype!~\"tmpfs|ramfs|overlay|squashfs|nsfs|zfs|fuse.*\", device!=\"tmpfs\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": ""
        }
      ],
