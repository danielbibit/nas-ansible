        "h": 5,
        "w": 5,
        "x": 4,
        "y": 1
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "100 * zfs_zpool_allocated_bytes{instance=~\"$host\", zpool=~\"$pool\"} / zfs_zpool_size_bytes{instance=~\"$host\", zpool=~\"$pool\"}",
          "instant": true,
          "legendFormat": "{{zpool}}",
          "range": false,
          "refId": ""
        }
      ],
      "title": "Capacity",
