      "repeatDirection": "h",
      "targets": [
        {
          "expr": "max by (zpool) (zfs_zpool_health{instance=~\"$host\", zpool=~\"$pool\", state=\"online\"} * 0 or zfs_zpool_health{instance=~\"$host\", zpool=~\"$pool\", state=\"degraded\"} or zfs_zpool_health{instance=~\"$host\", zpool=~\"$pool\", state!~\"online|degraded\"} * 2)",
