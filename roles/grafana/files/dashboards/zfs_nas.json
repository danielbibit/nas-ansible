      "title": "Health",
      "transparent": false,
      "type": "stat"
    },
    {
      "fieldConfig": {
        "defaults": {
          "max": 100.0,
          "min": 0.0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 80
              },
              {
                "color": "red",
                "value": 95
              }
            ]
